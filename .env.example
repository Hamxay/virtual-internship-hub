# Copy this file to `.env` in project root before `docker compose up --build`

# Compose runtime
RESTART_POLICY=unless-stopped
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=15

# Images
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Container names
DB_CONTAINER_NAME=vih_db
REDIS_CONTAINER_NAME=vih_redis
BACKEND_CONTAINER_NAME=vih_backend
CELERY_CONTAINER_NAME=vih_celery
FRONTEND_CONTAINER_NAME=vih_frontend

# Port mapping (host:container)
DB_PORT_HOST=5432
DB_PORT_CONTAINER=5432
REDIS_PORT_HOST=6379
REDIS_PORT_CONTAINER=6379
BACKEND_PORT_HOST=8001
BACKEND_PORT_CONTAINER=8001
FRONTEND_PORT_HOST=3000
FRONTEND_PORT_CONTAINER=3000

# Service commands
BACKEND_COMMAND=python manage.py migrate && daphne -b 0.0.0.0 -p 8001 config.asgi:application
CELERY_COMMAND=celery -A config worker -l info
FRONTEND_COMMAND=npm start
CHOKIDAR_USEPOLLING=true

# Django
DEBUG=True
SECRET_KEY=change-me-in-production

# Postgres
DB_NAME=virtual_internship_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# OpenRouter (optional for AI features)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b:free
OPENROUTER_PROJECT_EVAL_MODEL=openai/gpt-oss-120b:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Virtual Internship Hub

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Frontend
REACT_APP_API_URL=http://localhost:8001/api

