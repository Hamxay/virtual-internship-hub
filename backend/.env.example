# Copy to .env and fill in values. Do not commit .env.

# Django
SECRET_KEY=your-secret-key
DEBUG=True

# Database (PostgreSQL)
DB_NAME=virtual_internship_hub
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail: use App Password, no spaces in .env)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# OpenRouter (AI evaluation + career coach)
OPENROUTER_API_KEY=your-openrouter-api-key
# Set this to a stronger model for better code evaluation (check your OpenRouter dashboard for valid model IDs)
# OPENROUTER_PROJECT_EVAL_MODEL=your-preferred-model-id
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional
# PASSWORD_RESET_OTP_EXPIRE_MINUTES=2

# Celery / Redis (required for background evaluation)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1
