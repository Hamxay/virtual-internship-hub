# Copy to .env and fill in values. Do not commit .env.

# Django
SECRET_KEY=your-secret-key
DEBUG=True

# Database (PostgreSQL)
DB_NAME=virtual_internship_hub
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5433

# Email (Gmail: use App Password, no spaces in .env)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password-no-spaces
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional
# PASSWORD_RESET_OTP_EXPIRE_MINUTES=2
